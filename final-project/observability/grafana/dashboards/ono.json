{
  "uid": "ono-overview",
  "title": "ONO - Operation: Negative One",
  "description": "Scan throughput and latency, findings by severity, verifier pass rate, and model latency/tokens from the app's /metrics endpoint.",
  "tags": ["ono", "security-scanner"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["15s", "30s", "1m", "5m", "15m"] },
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active scans",
      "description": "Scans running on a worker right now (ono_active_scans).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "max(ono_active_scans)", "legendFormat": "active" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "area", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#3987e5" } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queued scans",
      "description": "Scans waiting for a free worker (ono_queued_scans).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "max(ono_queued_scans)", "legendFormat": "queued" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "area", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#d95926" } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scans done (range)",
      "description": "Scans that ended with status=done in the selected time range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ono_scans_total{status=\"done\"}[$__range]))", "legendFormat": "done" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#3987e5" } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scans failed (range)",
      "description": "Scans that ended with status=failed in the selected time range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ono_scans_total{status=\"failed\"}[$__range]))", "legendFormat": "failed" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "#d03b3b" } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Verifier pass rate (range)",
      "description": "pass / (pass + fail) over the selected range. 'skip' (no verdict, the service backend's pass-through) is excluded from the denominator.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ono_verifier_results_total{result=\"pass\"}[$__range])) / clamp_min(sum(increase(ono_verifier_results_total{result=~\"pass|fail\"}[$__range])), 1)",
          "legendFormat": "pass rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 0, "min": 0, "max": 1, "color": { "mode": "fixed", "fixedColor": "#0ca30c" } },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Model error rate (range)",
      "description": "Chat-completion requests that failed / all requests, over the selected range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ono_model_requests_total{outcome=\"error\"}[$__range])) / clamp_min(sum(increase(ono_model_requests_total[$__range])), 1)",
          "legendFormat": "error rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "none", "textMode": "value", "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "color": { "mode": "fixed", "fixedColor": "#d03b3b" } },
        "overrides": []
      }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Scan completions per minute",
      "description": "rate(ono_scans_total[5m]) by final status, scaled to per minute.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(ono_scans_total[5m])) * 60", "legendFormat": "{{status}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 2, "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "done" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scan duration (p50 / p95)",
      "description": "histogram_quantile over ono_scan_duration_seconds_bucket (15m window). Worker pick-up to end.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ono_scan_duration_seconds_bucket[15m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ono_scan_duration_seconds_bucket[15m])))", "legendFormat": "p95" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] }
        ]
      }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Findings per hour by severity",
      "description": "increase(ono_findings_total[1h]) by severity, stacked. Colors are the fixed status palette (low=good ... critical=critical).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by (severity) (increase(ono_findings_total[1h]))", "legendFormat": "{{severity}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 85, "stacking": { "mode": "normal", "group": "A" }, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "low" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }] },
          { "matcher": { "id": "byName", "options": "medium" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#fab219" } }] },
          { "matcher": { "id": "byName", "options": "high" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ec835a" } }] },
          { "matcher": { "id": "byName", "options": "critical" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      }
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Findings by output rung (since start)",
      "description": "ono_findings_total summed by rung. 1=flag, 2=+CWE+patch, 3=+reachability proof, 4=+fix proof (target floor), 5=+detection rule.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by (rung) (ono_findings_total)", "legendFormat": "rung {{rung}}" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "color", "namePlacement": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "#3987e5" } },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Verifier results per hour",
      "description": "increase(ono_verifier_results_total[1h]) by result: pass (verdict true), fail (dropped), skip (passed through without a verdict).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (increase(ono_verifier_results_total[1h]))", "legendFormat": "{{result}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 85, "stacking": { "mode": "normal", "group": "A" }, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pass" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }] },
          { "matcher": { "id": "byName", "options": "fail" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] },
          { "matcher": { "id": "byName", "options": "skip" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#898781" } }] }
        ]
      }
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Model request latency (p50 / p95)",
      "description": "histogram_quantile over ono_model_latency_seconds_bucket (5m window). One /chat/completions round-trip. TTFT is not observed (non-streaming client) - see the vLLM scrape job in prometheus.yml.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ono_model_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ono_model_latency_seconds_bucket[5m])))", "legendFormat": "p95" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] }
        ]
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Model requests per minute",
      "description": "rate(ono_model_requests_total[5m]) by outcome, scaled to per minute.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(ono_model_requests_total[5m])) * 60", "legendFormat": "{{outcome}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1, "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ok" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Model tokens per second",
      "description": "rate(ono_model_tokens_total[5m]) by kind (prompt vs completion), from the usage block of each reply.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (rate(ono_model_tokens_total[5m]))", "legendFormat": "{{kind}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1, "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal", "group": "A" }, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "prompt" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "completion" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      }
    }
  ]
}
