# Jetstream2 / production profile. Copy to .env on the instance (never commit .env).
# Note: values are taken verbatim by docker --env-file / compose env_file - do not quote them.
APP_NAME=Operation: Negative One
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Deliverable 2: the deployed prototype runs the mocked analyzer.
# Deliverable 3: switch to `local` once vLLM is running on the same g3.large
# (vLLM listens on 127.0.0.1:8000 and is never published outside the host).
MODEL_BACKEND=mock
MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct

# Only needed when MODEL_BACKEND=service.
# MODEL_SERVICE_URL=http://127.0.0.1:8000/v1
# MODEL_SERVICE_API_KEY=

MAX_VERIFIER_RETRIES=3

# --- Executor service + sandbox jail (Deliverable 3, step 3a) ---------------------
# The Executor is a separate, internal-only container that owns the Docker socket and
# spawns one jailed target container per scan. It refuses to start without a token:
#   openssl rand -hex 32
EXECUTOR_TOKEN=
# EXECUTOR_URL=http://executor:8081        # how the app reaches it (compose service name)
# EXECUTOR_HOST=127.0.0.1                  # bind address when run outside compose
# EXECUTOR_PORT=8081
# SANDBOX_IMAGE=python:3.13-slim           # base image of the jailed target containers
# SANDBOX_MEM_MB=1024                      # memory limit per jail (no swap; tmpfs counts)
# SANDBOX_CPUS=1.0
# SANDBOX_PIDS_LIMIT=256
# SANDBOX_CMD_TIMEOUT_S=300                # hard cap on any single run()/run_tests()
# SANDBOX_TTL_S=1800                       # sweeper force-removes older jails (orphans too)
# SANDBOX_OUTPUT_CAP_BYTES=1000000
# SANDBOX_WORKSPACE_MB=512
# SANDBOX_MAX_ACTIVE=8
