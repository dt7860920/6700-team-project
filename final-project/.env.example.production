# Jetstream2 / production profile. Copy to .env on the instance (never commit .env).
# Note: values are taken verbatim by docker --env-file / compose env_file - do not quote them.
APP_NAME=Operation: Negative One
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Deliverable 2: the deployed prototype runs the mocked analyzer.
# Deliverable 3: switch to `local` once vLLM is running on the same g3.large
# (vLLM listens on 127.0.0.1:8000 and is never published outside the host).
MODEL_BACKEND=mock
MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct

# --- Tier-2 auth: who may start scans (docs/auth.md) -----------------------------------
# false = open prototype (Deliverable 2 behaviour). true = POST /scans and POST /sources/check
# need a "Sign in with GitHub" session cookie or the static bearer below; startup fails fast
# if it is on but anything below is missing.
AUTH_REQUIRED=false
# HMAC key for our own session cookie (>= 32 chars):           openssl rand -hex 32
AUTH_SESSION_SECRET=
# Optional static bearer for CI / curl / make smoke-live (>= 16 chars):   openssl rand -hex 32
# AUTH_API_TOKEN=
# GitHub OAuth App (github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth App).
# Authorization callback URL registered there MUST equal GITHUB_OAUTH_CALLBACK_URL, which is
# the deployed origin + /auth/github/callback (https://<domain-or-ip>/auth/github/callback).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
# Cookies are Secure (HTTPS only) by default - keep it that way in production.
# COOKIE_SECURE=true
# Per-client-IP limit on the gated routes (0 disables).
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_S=60

# --- TLS front door: docker compose --profile tls (Caddyfile) --------------------------
# ONO_DOMAIN=ono.example.org               # Caddy site address (or the bare IP + `tls internal`)
# ONO_APP_BIND=127.0.0.1                   # keep the app's :8080 off the public interface
# TRUSTED_PROXY=true                       # Caddy is the only way in: rate-limit on X-Forwarded-For

# Only needed when MODEL_BACKEND=service.
# MODEL_SERVICE_URL=http://127.0.0.1:8000/v1
# MODEL_SERVICE_API_KEY=

MAX_VERIFIER_RETRIES=3

# --- Scan workers + the polling UI ---------------------------------------------------
# POST /scans is asynchronous (202 + scan_id; poll GET /scans/{id}). Each active scan holds
# a model session and (service backend) one sandbox, so concurrency is capped; overflow
# waits in a bounded queue, beyond which the API answers 429 "busy".
# MAX_ACTIVE_SCANS=2                       # scans running at the same time (worker threads)
# MAX_QUEUED_SCANS=8                       # scans allowed to wait for a worker
# UI_POLL_INTERVAL_S=1.0                   # how often the UI refreshes a running scan
# UI_POLL_TIMEOUT_S=3600                   # how long the UI keeps watching one scan

# --- Executor service + sandbox jail (Deliverable 3, step 3a) ---------------------
# The Executor is a separate, internal-only container that owns the Docker socket and
# spawns one jailed target container per scan. It refuses to start without a token:
#   openssl rand -hex 32
EXECUTOR_TOKEN=
# EXECUTOR_URL=http://executor:8081        # how the app reaches it (compose service name)
# EXECUTOR_HOST=127.0.0.1                  # bind address when run outside compose
# EXECUTOR_PORT=8081
# SANDBOX_IMAGE=python:3.13-slim           # base image of the jailed target containers
# SANDBOX_MEM_MB=1024                      # memory limit per jail (no swap; tmpfs counts)
# SANDBOX_CPUS=1.0
# SANDBOX_PIDS_LIMIT=256
# SANDBOX_CMD_TIMEOUT_S=300                # hard cap on any single run()/run_tests()
# SANDBOX_TTL_S=1800                       # sweeper force-removes older jails (orphans too)
# SANDBOX_OUTPUT_CAP_BYTES=1000000
# SANDBOX_WORKSPACE_MB=512
# SANDBOX_MAX_ACTIVE=8
# SANDBOX_DEPS_ENABLED=true                # build declared Python deps in a hardened builder
# SANDBOX_DEPS_TIMEOUT_S=300               # wall-clock cap on one dependency build
# SANDBOX_DEPS_MAX_MB=256                  # installed-size cap (= the jail's /deps tmpfs)
# SANDBOX_DEPS_INDEX_URL=                  # internal PyPI mirror for the builder (unset = PyPI)
