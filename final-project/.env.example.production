# Jetstream2 / production profile. Copy to .env on the instance (never commit .env).
# Note: values are taken verbatim by docker --env-file / compose env_file - do not quote them.
APP_NAME=Operation: Negative One
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Deliverable 2: the deployed prototype runs the mocked analyzer.
# Deliverable 3: switch to `local` once vLLM is running on the same g3.large
# (vLLM listens on 127.0.0.1:8000 and is never published outside the host).
MODEL_BACKEND=mock
MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct

# Only needed when MODEL_BACKEND=service.
# MODEL_SERVICE_URL=http://127.0.0.1:8000/v1
# MODEL_SERVICE_API_KEY=

MAX_VERIFIER_RETRIES=3
