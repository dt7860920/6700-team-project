# Service-backend profile: ONO calls a real model through an OpenAI-compatible
# endpoint (the team runs Ollama on the instance). Copy to .env (never commit .env).
# Note: values are taken verbatim by docker --env-file / compose env_file - do not quote them.
APP_NAME=Operation: Negative One
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Deliverable 3, step 3b-1: real ingest (shallow clone into WORKSPACE_DIR/<scan_id>,
# .git stripped) + Semgrep SAST shortlist + the agentic detection core: per candidate a
# planner call and an analyst ReAct loop that read the code ONLY through the jailed
# sandbox Executor (EXECUTOR_URL / EXECUTOR_TOKEN below are therefore required).
# The verifier is still a pass-through; findings come back verified=false.
MODEL_BACKEND=service
MODEL_SERVICE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5-coder:7b
# Ollama needs no key. Set this for endpoints that require `Authorization: Bearer`.
# MODEL_SERVICE_API_KEY=

MAX_VERIFIER_RETRIES=3

# Ingest + SAST (defaults shown). Needs `git` on PATH; Semgrep comes with `uv sync`.
# WORKSPACE_DIR=.ono-workspace          # per-scan clones live here, removed after each scan
# SAST_RULESET=p/owasp-top-ten          # comma-separated Semgrep --config values; "" = regex only
# MAX_CANDIDATES=20                     # cap on SAST candidates == cap on model calls per scan
# CONTEXT_LINES=25                      # code shown to the model on each side of a sink
# CLONE_TIMEOUT_S=120
# MAX_CLONE_MB=200

# --- Agents (step 3b-1; defaults shown) ------------------------------------------
# Model calls per scan are bounded by MAX_CANDIDATES x (ANALYST_MAX_STEPS + 1 if planner).
# PLANNER_ENABLED=true                  # one planner call per candidate before the analyst
# ANALYST_MAX_STEPS=8                   # hard cap on analyst model calls per candidate
# AGENT_TEMPERATURE=0.0
# AGENT_TOOL_PROTOCOL=auto              # auto | native (OpenAI tools) | text (JSON action)
# AGENT_TOOL_OUTPUT_CHARS=6000          # truncate any tool result fed back to the model
# AGENT_CANDIDATE_TIMEOUT_S=300         # wall-clock budget per candidate
# AGENT_TRAJECTORY_DIR=.ono-trajectories  # unset = log only; set = JSONL per scan

# --- Executor service + sandbox jail (Deliverable 3, step 3a) ---------------------
# The Executor is a separate, internal-only container that owns the Docker socket and
# spawns one jailed target container per scan. It refuses to start without a token, and
# MODEL_BACKEND=service refuses to boot without one (the agents have no other way to read
# the target):
#   openssl rand -hex 32
EXECUTOR_TOKEN=
# EXECUTOR_URL=http://executor:8081        # how the app reaches it (compose service name)
# EXECUTOR_HOST=127.0.0.1                  # bind address when run outside compose
# EXECUTOR_PORT=8081
# SANDBOX_IMAGE=python:3.13-slim           # base image of the jailed target containers
# SANDBOX_MEM_MB=1024                      # memory limit per jail (no swap; tmpfs counts)
# SANDBOX_CPUS=1.0
# SANDBOX_PIDS_LIMIT=256
# SANDBOX_CMD_TIMEOUT_S=300                # hard cap on any single run()/run_tests()
# SANDBOX_TTL_S=1800                       # sweeper force-removes older jails (orphans too)
# SANDBOX_OUTPUT_CAP_BYTES=1000000
# SANDBOX_WORKSPACE_MB=512
# SANDBOX_MAX_ACTIVE=8
