# Service-backend profile: ONO calls a real model through an OpenAI-compatible
# endpoint (the team runs Ollama on the instance). Copy to .env (never commit .env).
# Note: values are taken verbatim by docker --env-file / compose env_file - do not quote them.
APP_NAME=Operation: Negative One
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Deliverable 3, step 2: real ingest (shallow clone into WORKSPACE_DIR/<scan_id>,
# .git stripped) + Semgrep SAST shortlist; the model confirms each candidate over
# the real code around the sink. Planner and verifier are still stubs.
MODEL_BACKEND=service
MODEL_SERVICE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5-coder:7b
# Ollama needs no key. Set this for endpoints that require `Authorization: Bearer`.
# MODEL_SERVICE_API_KEY=

MAX_VERIFIER_RETRIES=3

# Ingest + SAST (defaults shown). Needs `git` on PATH; Semgrep comes with `uv sync`.
# WORKSPACE_DIR=.ono-workspace          # per-scan clones live here, removed after each scan
# SAST_RULESET=p/owasp-top-ten          # comma-separated Semgrep --config values; "" = regex only
# MAX_CANDIDATES=20                     # cap on SAST candidates == cap on model calls per scan
# CONTEXT_LINES=25                      # code shown to the model on each side of a sink
# CLONE_TIMEOUT_S=120
# MAX_CLONE_MB=200
